{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.questpulse.no" }],
      "destination": "https://questpulse.no/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.digitalcoachub.no" }],
      "destination": "https://digitalcoachub.no/:path*",
      "permanent": true
    },
    { "source": "/pilot", "destination": "/enterprise-evaluering", "permanent": true },
    { "source": "/en/pilot", "destination": "/en/enterprise-evaluation", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "digitalcoachub.no" }],
      "destination": "/dchub"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "digitalcoachub.no" }],
      "destination": "/dchub/:path*"
    }
  ]
}
